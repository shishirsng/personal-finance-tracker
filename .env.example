# Application Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Personal Finance Tracker API"
API_V1_PREFIX="/api/v1"

# Security & JWT Tokens
# Generate in production using: openssl rand -hex 32
SECRET_KEY=change_me_super_secret_key_minimum_32_characters_long_for_security!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_secret
POSTGRES_DB=finance_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
# Optional full URI override (if set, takes precedence):
# DATABASE_URL=postgresql+asyncpg://finance_user:finance_secret@localhost:5432/finance_db

# Redis (Cache, Rate Limiting, Idempotency, ARQ Jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Optional full URI override:
# REDIS_URL=redis://:password@localhost:6379/0

# Cross-cutting Behavior Tunables
REPORT_CACHE_TTL_SECONDS=300
IDEMPOTENCY_KEY_TTL_SECONDS=86400
AUTH_RATE_LIMIT_PER_MINUTE=5
